# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Local development (default): zero-setup SQLite file. Nothing to install.
DATABASE_URL="file:./dev.db"

# Production: PostgreSQL. No schema editing needed — just set two env vars:
#   DATABASE_PROVIDER="postgresql"
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# (The build runs scripts/use-db-provider.mjs to apply the provider.)
# DATABASE_PROVIDER selects the Prisma datasource provider (default: sqlite).
DATABASE_PROVIDER="sqlite"

# ---------------------------------------------------------------------------
# AUTH (optional — the app runs single-user without it)
# ---------------------------------------------------------------------------
# Set AUTH_ENABLED=true and configure NextAuth/Auth.js to enable multi-user.
AUTH_ENABLED="false"
# NEXTAUTH_SECRET="run: openssl rand -base64 32"
# NEXTAUTH_URL="http://localhost:3000"
