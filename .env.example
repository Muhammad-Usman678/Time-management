# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Local development (default): zero-setup SQLite file. Nothing to install.
DATABASE_URL="file:./dev.db"

# Production: PostgreSQL. To switch:
#   1. In prisma/schema.prisma set:  provider = "postgresql"
#   2. Set DATABASE_URL below (and run `docker compose up -d` for a local PG).
# DATABASE_URL="postgresql://phd:phd@localhost:5432/phd_productivity?schema=public"

# ---------------------------------------------------------------------------
# AUTH (optional — the app runs single-user without it)
# ---------------------------------------------------------------------------
# Set AUTH_ENABLED=true and configure NextAuth/Auth.js to enable multi-user.
AUTH_ENABLED="false"
# NEXTAUTH_SECRET="run: openssl rand -base64 32"
# NEXTAUTH_URL="http://localhost:3000"
