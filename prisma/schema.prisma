// PhD Productivity — data model
// -----------------------------------------------------------------------------
// Default provider is SQLite for zero-setup local development.
// For production, switch `provider` to "postgresql" and point DATABASE_URL at a
// Postgres instance (see docker-compose.yml). The schema is intentionally
// portable: no native enums or scalar arrays are used, so it runs identically on
// SQLite and PostgreSQL. Enum-like fields (priority/status/linkType/type) are
// stored as strings and validated at the application layer with Zod.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // change to "postgresql" for production
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         Task[]
  tags          Tag[]
  meetings      Meeting[]
  focusSessions FocusSession[]
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  priority    String    @default("medium") // "low" | "medium" | "high"
  status      String    @default("todo")    // "todo" | "in_progress" | "done"
  deadline    DateTime?
  isDaily     Boolean   @default(false)      // recurring daily task (auto-resets)
  lastResetAt DateTime? // bookkeeping for the daily auto-reset
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags          TagsOnTasks[]
  focusSessions FocusSession[]

  @@index([userId, status])
  @@index([userId, deadline])
  @@index([userId, isDaily])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#64748b")
  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TagsOnTasks[]

  @@unique([userId, name])
  @@index([userId])
}

// Explicit many-to-many join (portable + lets us add metadata later).
model TagsOnTasks {
  taskId     String
  tagId      String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model Meeting {
  id              String   @id @default(cuid())
  userId          String
  title           String
  dateTime        DateTime
  durationMinutes Int      @default(30)
  link            String?
  linkType        String   @default("none") // "zoom" | "meet" | "custom" | "none"
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateTime])
}

model FocusSession {
  id             String    @id @default(cuid())
  userId         String
  taskId         String?
  type           String    @default("pomodoro") // "pomodoro" | "custom" | "manual"
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  plannedSeconds Int       @default(1500) // intended length (e.g. 25 min)
  elapsedSeconds Int       @default(0)    // actual focused time logged
  completed      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([taskId])
}
